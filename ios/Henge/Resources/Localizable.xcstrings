          }
        }
      }
    },
    "「%@」需要約 %@ 可用空間，目前僅剩 %@。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” needs about %@ of free space, but only %@ remains."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」需要約 %@ 可用空間，目前僅剩 %@。"
          }
        }
      }
    },
    "「先點後拖」可縮短一般點擊反應時間，但開始按住拖曳前會先送出一次單擊。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click Then Drag reduces normal click latency, but sends one click before a press-and-hold drag begins."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「先點後拖」可縮短一般點擊反應時間，但開始按住拖曳前會先送出一次單擊。"
          }
        }
      }
    },
    "「延遲長按」會偵測您是短按或長按音量鍵，所有點擊約為 0.5 秒。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delayed Long Press distinguishes short and long volume-key presses. Every click takes about 0.5 seconds."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「延遲長按」會偵測您是短按或長按音量鍵，所有點擊約為 0.5 秒。"
          }
        }
      }
    },
    "「效能模式」可減少約 30% GPU 繪圖負荷。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Performance Mode can reduce GPU rendering load by about 30%."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「效能模式」可減少約 30% GPU 繪圖負荷。"
          }
        }
      }
    },
    "「跟隨系統」會隨 %@ 的淺色／深色設定切換；執行 Mac 畫面期間固定為深色。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System follows your %@'s light or dark appearance. The Mac display stays in dark mode while running."
